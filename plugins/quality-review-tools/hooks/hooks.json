{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/scripts/claude-surface-canary.sh\" claude-plugin-hook-sessionstart",
            "timeout": 5,
            "statusMessage": "Recording local plugin hook canary"
          }
        ]
      }
    ]
  }
}
